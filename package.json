{
  "name": "insert-numbers-ex",
  "displayName": "Insert Numbers Ex",
  "description": "Insert increasing numbers, hex values, dates, times, localized numbers, letters, and repeated sequences.",
  "keywords": [
    "insert",
    "numbers",
    "sequence",
    "sequences",
    "date",
    "datetime",
    "time",
    "hex",
    "binary",
    "octal",
    "radix",
    "localized",
    "letters",
    "alphabet",
    "repeat",
    "repetition",
    "cycling",
    "Japanese",
    "Chinese",
    "Korean",
    "Arabic",
    "Greek",
    "Cyrillic"
  ],
  "version": "1.1.9",
  "publisher": "almiraj",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/almiraj/insert-numbers-ex"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:insert-numbers-ex.insertNumbersEx"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "insert-numbers-ex.insertNumbersEx",
        "title": "Insert Numbers Ex"
      }
    ],
    "keybindings": [
      {
        "command": "insert-numbers-ex.insertNumbersEx",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3",
    "vsce": "^2.15.0"
  }
}
